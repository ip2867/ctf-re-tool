# 依赖（体积大，不入库）
node_modules/

# 编辑器 / 会话工具产物
.zcode/
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log

# 运行期产物：每题一个 CASE 证据目录（含题目答案，禁止入库）
cases/

# scripts/ 是运行期输出目录（生成的脚本/写题报告）；本目录下的一次性调试脚本不入库
scripts/

# 逆向解包/提取产物
androguard.db
*_so/
*_extracted/
*_decoded/
*_decoded*/
classes.dex
so/
apk_x/

# 临时 / 凭据
*.tmp
*.bak
.env
env.json

# 会话交接文档（含真实 flag/内网地址/本机路径，不入库）
HANDOFF.md

# 打包产物（electron-builder 输出，体积大，不入库）
dist/
dist-*/

# 便携版 exe（74MB 二进制）：只随 GitHub Release 分发，不入库
CTF-RE-TOOL.exe
*.exe.sha256

# 本地临时辅助脚本/输出（_build.cmd、_monitor.js、_*out.txt 等）
_build*.cmd
_build*.txt
_*.js
_*.log

# Python 缓存（内置 pyc 助手运行/编译产物）
__pycache__/
*.pyc

# 单测运行期产物（tests/test_scan_disguise.js 会释放出 stage2 中间文件）
tests/_stage2.bin

# 解题过程留下的临时产物（AI 写出的中间文件）
payload.bin
rks.txt
sbox_S.bin

# 回归题集：真实赛题二进制体积大、属第三方题目，不入库（只保留 expect.json 与说明）。
# 本地准备：把题目文件放到 tests/regression/<case>/ 下（文件名见各 expect.json 的 main 字段）。
tests/regression/*/*
!tests/regression/*/expect.json
!tests/regression/README.md

# 自动测试运行期产物（日志/汇总，每次跑都变，不入库）
autotest-logs/
autotest-summary.json
autotest-run.log

# 自动测试：题目清单/尝试记录（运行期数据，不入库）
_reverse_full.json
autotest-attempted.json
