# 依赖（体积大，不入库）
node_modules/

# 编辑器 / 会话工具产物
.zcode/
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log

# 运行期产物：每题一个 CASE 证据目录（含题目答案，禁止入库）
cases/

# scripts/ 是运行期输出目录（生成的脚本/写题报告）；本目录下的一次性调试脚本不入库
scripts/

# 逆向解包/提取产物
androguard.db
*_so/
*_extracted/
*_decoded/
*_decoded*/
classes.dex
so/
apk_x/

# 临时 / 凭据
*.tmp
*.bak
.env
env.json

# 一次性调试脚本与产物（.tmp_xxx.js/.txt/.bin 等）：
# 常含本机绝对路径、内网 IP、甚至明文口令，绝不入库
.tmp_*
!.tmp_solve_run/
.tmp_solve_run/*
!.tmp_solve_run/.gitkeep

# 单测里的 Kali 账号密码一律走环境变量（KALI_HOST/KALI_USER/KALI_PASS），禁止硬编码。
# 历史版本 tests/manual_dbg_*.js 曾写死真实口令，已清理。

# 会话交接文档（含真实 flag/内网地址/本机路径，不入库）
HANDOFF.md

# 批跑/解题记录报告（含真实平台 flag 与本机路径，属运行期数据，不入库）
批量解题记录报告.md
*实战记录*.md

# 打包产物（electron-builder 输出，体积大，不入库）
dist/
dist-*/

# 便携版 exe（74MB 二进制）：只随 GitHub Release 分发，不入库
CTF-RE-TOOL.exe
*.exe.sha256

# 本地临时辅助脚本/输出（_build.cmd、_monitor.js、_*out.txt 等）
_build*.cmd
_build*.txt
_*.js
_*.log

# Python 缓存（内置 pyc 助手运行/编译产物）
__pycache__/
*.pyc

# 单测运行期产物（tests/test_scan_disguise.js 会释放出 stage2 中间文件）
tests/_stage2.bin

# 解题过程留下的临时产物（AI 写出的中间文件）
payload.bin
rks.txt
sbox_S.bin

# 回归题集：真实赛题二进制体积大、属第三方题目，不入库（只保留 expect.json 与说明）。
# 本地准备：把题目文件放到 tests/regression/<case>/ 下（文件名见各 expect.json 的 main 字段）。
tests/regression/*/*
!tests/regression/*/expect.json
!tests/regression/README.md

# 自动测试运行期产物（日志/汇总，每次跑都变，不入库）
autotest-logs/
autotest-summary.json
autotest-run.log

# 自动测试：题目清单/尝试记录（运行期数据，不入库）
_reverse_full.json
autotest-attempted.json

# 逆向调试过程残留（反汇编输出、内存/常量表 dump、临时二进制切片）
# 这些是解题时落在仓库根的中间产物，曾被误提交进历史，现已 untrack 并在此拦截。
dis.txt
disasm.txt
dis_prologue.txt
full_disasm.txt
dump.txt
strings.txt
kanxue_api.py
kanxue_api.txt
*.bin
payload.bin
classes.dex
sbox_S.bin

# 运行期汇总（本机数据，不入库）
autotest-summary.json
mid-bank-summary.json
p1-verify-summary.json
solved-challenges.json
skipped-challenges.json
